# Tafahhum — copy to .env and fill in. .env is gitignored; never commit it.

# ---------------------------------------------------------------- database ---
# Used by both the db container and the API. No default is provided for the
# password on purpose: the production compose file refuses to start without it.
POSTGRES_DB=tafahhum
POSTGRES_USER=tafahhum
POSTGRES_PASSWORD=

# ------------------------------------------------------------------ serving --
# A real hostname makes Caddy obtain and renew TLS automatically. Leave empty
# to serve plain HTTP on :80 — acceptable locally, not for a public host.
TAFAHHUM_DOMAIN=

# Extra browser origins allowed to call the API. Normally empty: the frontend is
# served from the same origin through Caddy, so no cross-origin call is made.
# A wildcard is ignored if set.
TAFAHHUM_CORS_ORIGINS=

# ------------------------------------------------------------------ images ---
# Container registry namespace and tag used by compose and CI.
REGISTRY=ghcr.io/OWNER/tafahhum
TAG=latest

# ------------------------------------------------------------- integrations --
# Optional. Enables passage translation and vision OCR. Without it the API
# returns an explicit 503 for translation and the Arabic is unaffected.
ANTHROPIC_API_KEY=

# Optional. Local translation backend, used when no API key is set.
TAFAHHUM_OLLAMA_MODEL=

# ------------------------------------------------------------ dev database ---
# Only read by docker-compose.yml (the development file).
POSTGRES_PORT=5544
